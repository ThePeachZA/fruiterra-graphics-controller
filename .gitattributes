# Normalise text files to LF in the repository and in checkouts. This keeps
# rustfmt, CI and local Windows builds consistent.
* text=auto eol=lf

# Binary assets.
*.ico binary
*.png binary
*.woff2 binary
*.exe binary
*.zip binary

# The third-party notices file is generated by cargo-about and must match the
# generated output byte for byte, so the trailing spaces that upstream licence
# texts carry are left alone instead of being flagged.
THIRD_PARTY_NOTICES.md whitespace=-trailing-space
